# ---------------------------------------------------------------------------
# Frontend (Vite) — PUBLIC configuration only. Everything prefixed with VITE_
# is embedded in the browser bundle. Never put secrets here.
# ---------------------------------------------------------------------------

# Supabase project URL: Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xvnmdekursegmwwchxyd.supabase.co

# Publishable key (sb_publishable_...). The legacy "anon" JWT key also works.
# Safe to expose: all data access is enforced by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_IaRsycxHaZR3R2EZUtmksg_k-C3ws--

# Canonical public URL of the site, without trailing slash.
# Used for canonical links, Open Graph URLs, robots.txt and sitemap.xml.
VITE_SITE_URL=http://localhost:5173

# Optional: Cloudflare Turnstile SITE key (public). Set together with the
# TURNSTILE_SECRET_KEY Edge Function secret to enable the captcha.
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Server-side secrets DO NOT belong in this file. Set them as Edge Function
# secrets instead (see supabase/functions/.env.example and the README):
#   IP_HASH_SALT, ALLOWED_ORIGINS, TURNSTILE_SECRET_KEY,
#   RESEND_API_KEY, CONTACT_FROM_EMAIL, CONTACT_NOTIFY_EMAIL
# ---------------------------------------------------------------------------
