# Edge Function secrets — set in production with:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Random string (32+ chars) used to hash visitor IPs for rate limiting.
IP_HASH_SALT=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the functions (CORS).
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173

# Optional — Cloudflare Turnstile secret key (pairs with VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# Optional — Resend email notifications for new contact messages.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <notifications@your-domain.com>
# Fallback recipient if no notification email is set in the admin panel.
CONTACT_NOTIFY_EMAIL=
